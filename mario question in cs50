#include <cs50.h>
#include <stdio.h>
int main()
{
    int height, i, j, k, l;

    do
    {
        height = get_int("Height: ");
    }
    while (height < 1 || height > 8);

    // for loop for the height of pyramid
    for (i = 1; i <= height; i++)
    {

        // this gives the spaces before the first brick

        for (j = 0; j < height - i; j++)
        {
            printf(" ");
        }

        // this gives the number of brick in a line
        for (k = 0; k < i; k++)
        {
            printf("#");
        }

        // constant gap bw triangles
        printf("  ");

        // this is number of bricks after gap
        for (l = 0; l < i; l++)
        {
            printf("#");
        }
        // new line to start the next line of bricks
        printf("\n");
    }
    return 0;
}
