int getcompchoi(){
    return (rand() % 3) + 1; 
}

int getuserchoi(){
    int choice = 0;
    do {
        printf("choose option: \n 1:rock\n2:paper\n3:scissor\n");
        scanf("%d", &choice);
    } while (choice < 1 || choice > 3);
    return choice;
}
                  
void checkwinner(int userchoi, int compchoi){
    if (userchoi == compchoi) {
        printf("It's a tie!\n");
    } 
    else if ((userchoi == 1 && compchoi == 3) || 
             (userchoi == 2 && compchoi == 1) || 
             (userchoi == 3 && compchoi == 2)) {
        printf("you win!!!\n");
    } 
    else {
        printf("You lose!!!\n");
    }
}
